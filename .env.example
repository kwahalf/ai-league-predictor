# Supabase (local dev, run by `supabase start`)
#
# Ports and URLs in this file are the dev defaults only. `make` sets them per stack from
# stacks/<stack>.env (dev or live), and those values win over this file.
#
# Auth keys are NOT committed here: newer Supabase CLIs generate per-instance
# signing keys, so the anon/service_role values differ on every machine.
# `make up` reads the live keys from `supabase start` and injects them
# automatically (see scripts/supabase-env.sh) -- you do NOT need to fill these in.
# They only matter if you bypass make and run `docker compose up` directly, in
# which case run `make supabase-status` and paste the real values here.
#
# Two URLs intentionally differ by run context:
#   SUPABASE_URL       -> used by the Temporal worker, which runs INSIDE Docker and
#                         reaches the host-bound Supabase via host.docker.internal.
#   VITE_SUPABASE_URL  -> used by the frontend, which runs in the browser on the HOST.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=injected-by-make-up
SUPABASE_SERVICE_ROLE_KEY=injected-by-make-up

# Temporal
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=main

# Frontend (browser on the host -> localhost)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=injected-by-make-up
VITE_API_URL=http://localhost:54321/functions/v1

# Agent
# AGENT_PROVIDER overrides the `provider` field of every agent config in
# temporal/agents/. Leave it EMPTY to use each agent's own provider, which now
# defaults to `litellm` -- start the proxy with:
#     docker compose --profile litellm up -d litellm
# Set it to `fake` to run the whole agent loop end to end with no model
# credentials, no proxy and no network -- useful for a first run and the tests.
AGENT_PROVIDER=

# Claude (provider: claude). Bedrock uses AWS_* instead; Foundry uses AZURE_*.
ANTHROPIC_API_KEY=

# Azure OpenAI GPT deployments (provider: azure_gpt)
#
# BASE_URL is the resource ROOT, not a full endpoint -- the adapter appends the
# path itself. API_STYLE picks which path:
#   deployments  {base}/openai/deployments/{deployment}/chat/completions
#                The default. Works on every Azure OpenAI resource, including
#                *.cognitiveservices.azure.com ones, with a dated api-version.
#   v1           {base}/openai/v1/chat/completions
#                The newer OpenAI-compatible surface. Rejects most dated
#                api-versions with "API version not supported".
# DEPLOYMENT defaults to the model named in the agent's YAML; set it only when the
# deployment is named differently from the model.
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_API_STYLE=deployments
AZURE_OPENAI_DEPLOYMENT=

# LiteLLM proxy (provider: litellm) -- the DEFAULT provider.
#
# Point BASE_URL at your proxy. A hosted one is the normal case:
#   LITELLM_BASE_URL=https://litellm.<something>.azurecontainerapps.io
# Or run one locally alongside the stack (opt-in, see litellm/config.yaml):
#   docker compose --profile litellm up -d litellm
#   LITELLM_BASE_URL=http://litellm:4000
#
# BASE_URL may be a bare host, a /v1 root, or a full chat-completions URL -- the
# adapter works out the rest.
#
# LITELLM_API_KEY is the key the WORKER sends. Use a key scoped to the models that
# worker is allowed to spend on, minted with /key/generate -- not the master key.
# The adapter deliberately refuses to fall back to LITELLM_MASTER_KEY, so that a
# worker never silently becomes an administrator of its own budget.
#
# LITELLM_MASTER_KEY is for the LOCAL compose proxy only, and must be NON-EMPTY if
# you enable auth there: the proxy reads it from its environment, and an empty value
# makes it 401 every request including unauthenticated ones. See litellm/config.yaml.
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=
# PROXY-SIDE ONLY. Setting this turns authentication on and is the admin
# credential used to mint scoped keys. The worker deliberately does NOT accept it
# as its token -- give the worker a key from /key/generate instead.
# Note: per-team keys and spend caps also need a database; see litellm/config.yaml.
LITELLM_MASTER_KEY=

# Where the browser reaches the agent API (a compose service on port 8000)
VITE_AGENT_API_URL=http://localhost:8000
