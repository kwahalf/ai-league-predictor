# Dev stack: where PRs are built and tested. The only stack that may ever be reset.
# Ports match the template defaults (Temporal UI moved to 8081: the runner uses 8080).
# No secrets here: those stay in .env.
STACK_NAME=dev
SUPABASE_PROJECT_ID=ai-league-predictor-dev
COMPOSE_PROJECT_NAME=ai-league-predictor-dev

SUPABASE_API_PORT=54321
SUPABASE_DB_PORT=54322
SUPABASE_DB_SHADOW_PORT=54320
SUPABASE_DB_POOLER_PORT=54329
SUPABASE_STUDIO_PORT=54323
SUPABASE_LOCAL_SMTP_PORT=54324
SUPABASE_ANALYTICS_PORT=54327
SUPABASE_EDGE_RUNTIME_INSPECTOR_PORT=8083

FRONTEND_PORT=3000
AGENT_API_PORT=8000
TEMPORAL_UI_PORT=8081
TEMPORAL_GRPC_PORT=7234
TEMPORAL_DB_PORT=5433
LITELLM_PORT=4000
