# Live stack: runs the schedules and holds the real data. Never reset it:
# new migrations go in with `make migrate STACK=live`, after a backup.
# Every port is offset from dev so both stacks can run side by side.
# No secrets here: those stay in .env.
STACK_NAME=live
SUPABASE_PROJECT_ID=ai-league-predictor-live
COMPOSE_PROJECT_NAME=ai-league-predictor-live

SUPABASE_API_PORT=55321
SUPABASE_DB_PORT=55322
SUPABASE_DB_SHADOW_PORT=55320
SUPABASE_DB_POOLER_PORT=55329
SUPABASE_STUDIO_PORT=55323
SUPABASE_INBUCKET_PORT=55324
SUPABASE_ANALYTICS_PORT=55327
SUPABASE_EDGE_RUNTIME_INSPECTOR_PORT=8183

FRONTEND_PORT=3100
AGENT_API_PORT=8100
TEMPORAL_UI_PORT=8181
TEMPORAL_GRPC_PORT=7334
TEMPORAL_DB_PORT=5533
LITELLM_PORT=4100

# Live never loads the demo seed: it holds real data only.
SUPABASE_DB_SEED_ENABLED=false
